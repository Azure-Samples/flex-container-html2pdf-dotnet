<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="pre-release" value="https://pkgs.dev.azure.com/azfunc/public/_packaging/pre-release/nuget/v3/index.json" />
    <add key="dotnet-public" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    <add key="nuget-public" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="pre-release">
      <package pattern="Microsoft.Azure.Functions.Worker" />
      <package pattern="Microsoft.Azure.Functions.Worker.Core" />
      <package pattern="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
      <package pattern="Microsoft.Azure.Functions.Worker.Grpc" />
      <package pattern="Microsoft.Azure.Functions.Worker.Sdk" />
    </packageSource>
    <packageSource key="dotnet-public">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nuget-public">
      <package pattern="PuppeteerSharp" />
      <package pattern="ReactiveExtensionsSharp" />
      <package pattern="WebDriverBiDi" />
    </packageSource>
  </packageSourceMapping>
</configuration>
